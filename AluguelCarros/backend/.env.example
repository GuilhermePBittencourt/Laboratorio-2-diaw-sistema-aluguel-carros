# Copie para .env (ou exporte as variáveis no terminal / IDE). NUNCA envie o .env ao GitHub.

# Supabase: Project Settings > Database > Connection string (JDBC)
# Use o "Session pooler" se a sua rede não tiver IPv6.
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=troque-pela-senha-do-banco

# Segredo do JWT: no mínimo 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
JWT_EXPIRACAO_MINUTOS=120

# Origens liberadas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# update = cria o que faltar | validate = só confere (use depois de rodar database/schema.sql)
DDL_AUTO=update

# Dados iniciais: sem SEED_SENHA_AGENTES os agentes de demonstração NÃO são criados
SEED_ENABLED=true
SEED_SENHA_AGENTES=troque-por-uma-senha-forte
